# Credentials live HERE and nowhere else — never in config.json, never
# in code, never in a log line. This file is gitignored; copy it to
# .env. The UI writes it for you, quoting values so a password with
# spaces or a # survives.

# Leg A — the CME / NYMEX / COMEX leg on an MT5 terminal
MT5_PASSWORD_CME=""

# Leg B — the MCX leg on Arrow. The TOTP secret is the base32 SEED from
# the authenticator setup, not the six-digit code. Arrow only accepts
# API logins from the static IP registered with it (SEBI rule).
ARROW_PASSWORD_MCX=""
ARROW_API_SECRET_MCX=""
ARROW_TOTP_SECRET_MCX=""

# Arbitrage alerts to your phone (optional). Create a bot with
# @BotFather for the token; message the bot once, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
